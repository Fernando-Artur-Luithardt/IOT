[{"id":"cp3-flow","type":"tab","label":"CP3 · Ponte, painel e Supabase","disabled":false,"info":"Leia docs/checkpoint3.md. Os módulos locais são carregados pelo settings.cjs. Nunca inclua credenciais neste fluxo.","env":[{"name":"MATRICULAS","type":"str","value":"1038854_1028775"}]},{"id":"local","type":"mqtt-broker","name":"Mosquitto local · Mega","broker":"${MQTT_LOCAL_HOST}","port":"1883","clientid":"${MQTT_LOCAL_CLIENT_ID}","autoConnect":false,"usetls":false,"protocolVersion":"4","keepalive":"15","cleansession":true,"autoUnsubscribe":true,"queueQoSZero":false},{"id":"cloud","type":"mqtt-broker","name":"HiveMQ · TLS validado","broker":"${MQTT_CLOUD_HOST}","port":"8883","clientid":"${MQTT_CLOUD_CLIENT_ID}","autoConnect":false,"usetls":true,"tls":"cloud-tls","protocolVersion":"4","keepalive":"15","cleansession":true,"autoUnsubscribe":true,"queueQoSZero":false,"willTopic":"${MQTT_BRIDGE_TOPIC}","willQos":"1","willRetain":true,"willPayload":"offline","closeTopic":"${MQTT_BRIDGE_TOPIC}","closeQos":"1","closeRetain":true,"closePayload":"offline"},{"id":"cloud-tls","type":"tls-config","name":"Validar CA pública e hostname/SNI","cert":"","key":"","ca":"","certname":"","keyname":"","caname":"","servername":"${MQTT_CLOUD_HOST}","verifyservercert":true,"alpnprotocol":""},{"id":"local-in","type":"mqtt in","z":"cp3-flow","name":"1 · Entrada MQTT local","topic":"unidavi/iot/t28/1038854_1028775/#","qos":"1","datatype":"utf8","broker":"local","nl":false,"rap":true,"rh":0,"inputs":0,"x":160,"y":100,"wires":[["bridge"]]},{"id":"cloud-out","type":"mqtt out","z":"cp3-flow","name":"Ponte → HiveMQ","topic":"","qos":"","retain":"","broker":"cloud","x":740,"y":100,"wires":[]},{"id":"cloud-in","type":"mqtt in","z":"cp3-flow","name":"2 · Retorno do HiveMQ","topic":"unidavi/iot/t28/1038854_1028775/#","qos":"1","datatype":"utf8","broker":"cloud","nl":false,"rap":true,"rh":0,"inputs":0,"x":160,"y":360,"wires":[["monitor"]]},{"id":"local-status","type":"status","z":"cp3-flow","name":"Conexão local","scope":["local-in"],"x":140,"y":180,"wires":[["local-link"]]},{"id":"cloud-status","type":"status","z":"cp3-flow","name":"Conexão TLS","scope":["cloud-in"],"x":140,"y":260,"wires":[["cloud-link"]]},{"id":"tick","type":"inject","z":"cp3-flow","name":"3 · Recalcular a cada 5 s","props":[{"p":"kind","v":"tick","vt":"str"}],"repeat":"5","crontab":"","once":true,"onceDelay":0.5,"topic":"","x":180,"y":440,"wires":[["monitor"]]},{"id":"drain-tick","type":"inject","z":"cp3-flow","name":"4 · Drenar fila a cada 2 s","props":[{"p":"payload"}],"repeat":"2","crontab":"","once":true,"onceDelay":1,"topic":"","payload":"","payloadType":"date","x":170,"y":640,"wires":[["outbox"]]},{"id":"supabase-http","type":"http request","z":"cp3-flow","name":"POST · chave pública · insert only","method":"use","ret":"txt","paytoqs":"ignore","url":"","tls":"","persist":false,"proxy":"","insecureHTTPParser":false,"authType":"","senderr":false,"headers":[],"requestTimeout":"10000","followRedirects":false,"x":700,"y":640,"wires":[["ack"]]},{"id":"http-catch","type":"catch","z":"cp3-flow","name":"Falha de transporte","scope":["supabase-http"],"uncaught":false,"x":720,"y":720,"wires":[["ack"]]},{"id":"base","type":"ui-base","name":"Espécies nativas · CP3","path":"/dashboard","includeClientData":true,"acceptsClientConfig":[],"showPathInSidebar":false,"navigationStyle":"default","titleBarStyle":"default"},{"id":"theme","type":"ui-theme","name":"Checkpoint 3","colors":{"surface":"#ffffff","primary":"#2e7d32","bgPage":"#f1f4f7","groupBg":"#ffffff","groupOutline":"#d8dee5"},"sizes":{"density":"default","pagePadding":"18px","groupGap":"18px","groupBorderRadius":"8px","widgetGap":"14px"}},{"id":"bridge","type":"function","z":"cp3-flow","name":"Validar prefixo e encaminhar","func":"const api=global.get('cp3Bridge');\nconst state=flow.get('bridge') || api.create();\nconst output=api.route(state,msg,env.get('MATRICULAS'));\nflow.set('bridge',state);\nreturn [output];","outputs":1,"timeout":0,"noerr":0,"initialize":"flow.set('bridge',global.get('cp3Bridge').create());","finalize":"","libs":[],"x":450,"y":100,"wires":[["cloud-out"]]},{"id":"local-link","type":"function","z":"cp3-flow","name":"Estado da conexão local","func":"return {kind:'local-link',connected:msg.status?.fill==='green' && msg.status?.shape==='dot'};","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":420,"y":180,"wires":[["bridge"]]},{"id":"cloud-link","type":"function","z":"cp3-flow","name":"Estado da conexão TLS","func":"const connected=msg.status?.fill==='green' && msg.status?.shape==='dot';\nreturn [{kind:'broker',connected},{kind:'cloud-link',connected}];","outputs":2,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":420,"y":260,"wires":[["monitor"],["bridge"]]},{"id":"monitor","type":"function","z":"cp3-flow","name":"Validar, guardar e calcular estado","func":"const api=global.get('cp3');\nlet state=flow.get('monitor');\nconst team=env.get('MATRICULAS');\nif (!state || state.team!==team) state=api.create(team);\nconst now=Date.now();\nif (msg.kind!=='tick') api.apply(state,msg,now);\napi.tick(state,now);\nflow.set('monitor',state);\nreturn ['aroeira-vermelha','inga'].map(slug=>({payload:api.snapshot(state,slug,now)}));","outputs":2,"timeout":0,"noerr":0,"initialize":"const api=global.get('cp3');\nlet state=flow.get('monitor');\nif (!state || state.team!==env.get('MATRICULAS')) state=api.create(env.get('MATRICULAS'));\napi.resetTransport(state,Date.now()); flow.set('monitor',state);","finalize":"","libs":[],"x":440,"y":400,"wires":[["aroeira-general","aroeira-sensors","aroeira-actuators","aroeira-history"],["inga-general","inga-sensors","inga-actuators","inga-history"]]},{"id":"outbox","type":"function","z":"cp3-flow","name":"Fila persistente e novas tentativas","func":"const state=flow.get('monitor'); if (!state) return null;\nconst request=global.get('cp3Persistence').next(state,Date.now(),env.get('SUPABASE_URL'),env.get('SUPABASE_KEY'));\nflow.set('monitor',state); return request;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":430,"y":640,"wires":[["supabase-http"]]},{"id":"ack","type":"function","z":"cp3-flow","name":"Confirmar gravação sem expor chaves","func":"const state=flow.get('monitor'); if (!state) return null;\nglobal.get('cp3Persistence').acknowledge(state,msg,Date.now());\nflow.set('monitor',state);\nnode.status({fill:state.failures?'yellow':'green',shape:'dot',text:state.db});\nreturn null;","outputs":0,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":1010,"y":640,"wires":[]},{"id":"page-aroeira","type":"ui-page","name":"Aroeira-vermelha","ui":"base","path":"/aroeira-vermelha","icon":"leaf","layout":"grid","theme":"theme","breakpoints":[{"name":"Default","px":"0","cols":"3"},{"name":"Tablet","px":"576","cols":"6"},{"name":"Desktop","px":"1024","cols":"12"}],"order":1,"visible":"true","disabled":"false"},{"id":"group-aroeira-general","type":"ui-group","name":"Estado geral","page":"page-aroeira","width":"12","height":"1","order":1,"showTitle":true,"visible":"true","disabled":"false","groupType":"default"},{"id":"aroeira-general","type":"ui-template","z":"cp3-flow","group":"group-aroeira-general","page":"","ui":"","name":"Aroeira-vermelha · Estado geral","order":1,"width":"12","height":"0","format":"<template>\n  <section v-if=\"msg?.payload\" class=\"cp3-general\" aria-live=\"polite\">\n    <nav class=\"cp3-tabs\" aria-label=\"Espécies\">\n      <a href=\"/dashboard/aroeira-vermelha\" :aria-current=\"msg.payload.slug==='aroeira-vermelha'?'page':undefined\">Aroeira-vermelha</a>\n      <a href=\"/dashboard/inga\" :aria-current=\"msg.payload.slug==='inga'?'page':undefined\">Ingá</a>\n    </nav>\n    <div class=\"cp3-status\" :style=\"{borderColor:msg.payload.color}\">\n      <strong :style=\"{color:msg.payload.color}\">{{msg.payload.general?.value || 'SEM DADOS'}}</strong>\n      <p>{{msg.payload.general?.reason}}</p>\n    </div>\n    <h2>{{msg.payload.name}}</h2><p><em>{{msg.payload.scientific}}</em> · {{msg.payload.family}}</p>\n    <p>Equipe {{msg.payload.team}} · Atualização: {{lastUpdate(msg.payload)}}</p>\n    <div class=\"cp3-connections\">\n      <span :class=\"msg.payload.broker ? 'cp3-good' : 'cp3-bad'\">HiveMQ: {{msg.payload.broker ? 'conectado' : 'desconectado'}}</span>\n      <span :class=\"msg.payload.bridge === 'online' ? 'cp3-good' : 'cp3-bad'\">Ponte local: {{msg.payload.bridge}}</span>\n      <span>Placa: {{msg.payload.board || 'sem status'}}</span>\n    </div>\n    <p class=\"cp3-small\">Banco: {{msg.payload.persistence.status}} · {{msg.payload.persistence.pending}} registro(s) na fila<span v-if=\"msg.payload.persistence.dropped\"> · {{msg.payload.persistence.dropped}} não armazenado(s)</span></p>\n  </section>\n  <p v-else>Sem leitura. Aguardando conexão.</p>\n</template>\n<script>\nexport default { methods: { lastUpdate(p) { const t = Math.max(...p.sensors.map(s => s.at || 0)); return t ? new Date(t).toLocaleTimeString('pt-BR') : 'sem leitura'; } } }\n</script>\n<style>\n.cp3-general h2{font-size:24px;margin:14px 0 4px}.cp3-general p{margin:6px 0;line-height:1.5}\n.cp3-status{border-left:6px solid;padding:12px 16px;background:#f7f8fa;border-radius:5px}\n.cp3-status strong{font-size:28px}.cp3-connections{display:flex;gap:12px;flex-wrap:wrap;margin:14px 0}\n.cp3-connections span{padding:6px 10px;border:1px solid #d8dee5;border-radius:6px}\n.cp3-good{color:#2e7d32}.cp3-bad{color:#c62828}.cp3-small{font-size:14px;color:#59616f}\n.cp3-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(260px,100%),1fr));gap:20px;padding:4px}\n.cp3-card{border:1px solid #d8dee5;border-radius:8px;padding:18px;min-width:0}.cp3-card h3{font-size:20px;margin:0 0 12px}\n.cp3-muted{color:#6b7280}.cp3-value{font-size:34px;font-weight:650;line-height:1.3}.cp3-unit{font-size:20px}\n.cp3-gauge{height:18px;position:relative;border-radius:3px;margin:22px 0 8px;border:1px solid #98a1ab}\n.cp3-needle{position:absolute;top:-6px;bottom:-6px;width:3px;background:#172330;transform:translateX(-50%)}\n.cp3-scale{display:flex;justify-content:space-between;font-size:13px}.cp3-card p{line-height:1.5;margin:8px 0}\n.cp3-chart{width:100%;height:auto;display:block}.cp3-chart text{font:13px sans-serif;fill:#505b68}\n.cp3-charts{display:grid;gap:20px}.cp3-rule{font-size:16px}.cp3-history-note{font-size:14px;color:#59616f}\n.cp3-tabs{display:flex;gap:8px;margin:0 0 16px;flex-wrap:wrap}.cp3-tabs a{padding:8px 14px;color:#374151;text-decoration:none;border-bottom:3px solid transparent}\n.cp3-tabs a[aria-current=page]{border-color:#2e7d32;color:#2e7d32;font-weight:700;background:#f0f7f0}\n@media(max-width:600px){.cp3-chart text{font-size:28px}}\n</style>\n","storeOutMessages":true,"passthru":false,"resendOnRefresh":true,"templateScope":"local","className":"","x":850,"y":330,"wires":[[]]},{"id":"group-aroeira-sensors","type":"ui-group","name":"Sensores","page":"page-aroeira","width":"12","height":"1","order":2,"showTitle":true,"visible":"true","disabled":"false","groupType":"default"},{"id":"aroeira-sensors","type":"ui-template","z":"cp3-flow","group":"group-aroeira-sensors","page":"","ui":"","name":"Aroeira-vermelha · Sensores","order":1,"width":"12","height":"0","format":"<template>\n  <div class=\"cp3-grid\" v-if=\"msg?.payload\">\n    <article v-for=\"s in msg.payload.sensors\" :key=\"s.sensor\" class=\"cp3-card\" :class=\"{'cp3-muted': !s.current}\">\n      <h3>{{s.sensor}}</h3>\n      <div class=\"cp3-value\">{{s.value === null ? 'sem leitura' : s.value.toFixed(1)}} <span class=\"cp3-unit\" v-if=\"s.value !== null\">{{s.unit}}</span></div>\n      <p>{{s.age === null ? 'Aguardando primeira amostra' : `há ${s.age} s`}}<span v-if=\"s.value !== null && !s.current\"> · leitura não atual</span></p>\n      <div class=\"cp3-gauge\" role=\"meter\" :aria-label=\"s.sensor\" aria-valuemin=\"0\" :aria-valuemax=\"s.max\" :aria-valuenow=\"s.value === null ? undefined : Math.max(0,Math.min(s.max,s.value))\" :style=\"{background:bands(s),opacity:s.current?1:0.4}\">\n        <span v-if=\"s.value !== null\" class=\"cp3-needle\" :style=\"{left:Math.max(0,Math.min(100,s.value/s.max*100))+'%'}\"></span>\n      </div>\n      <div class=\"cp3-scale\"><span>0 {{s.unit}}</span><span>Limiar: {{s.limit}} {{s.unit}}</span><span>{{s.max}} {{s.unit}}</span></div>\n      <p class=\"cp3-small\">Amarelo: {{s.sensor}} {{s.op}} {{s.limit}} {{s.unit}}. Verde: sem atuação desta regra.</p>\n    </article>\n  </div>\n</template>\n<script>\nexport default { methods: { bands(s) { const a=s.limit/s.max*100,b=(a+100)/2; const c=s.op==='<'?['#fbc02d','#2e7d32','#2e7d32']:['#2e7d32','#fbc02d','#fbc02d']; return `linear-gradient(to right,${c[0]} 0%,${c[0]} ${a}%,${c[1]} ${a}%,${c[1]} ${b}%,${c[2]} ${b}%,${c[2]} 100%)`; } } }\n</script>\n","storeOutMessages":true,"passthru":false,"resendOnRefresh":true,"templateScope":"local","className":"","x":850,"y":390,"wires":[[]]},{"id":"group-aroeira-actuators","type":"ui-group","name":"Atuadores","page":"page-aroeira","width":"12","height":"1","order":3,"showTitle":true,"visible":"true","disabled":"false","groupType":"default"},{"id":"aroeira-actuators","type":"ui-template","z":"cp3-flow","group":"group-aroeira-actuators","page":"","ui":"","name":"Aroeira-vermelha · Atuadores","order":1,"width":"12","height":"0","format":"<template>\n  <div class=\"cp3-grid\" v-if=\"msg?.payload\">\n    <article v-for=\"a in msg.payload.actuators\" :key=\"a.name\" class=\"cp3-card\">\n      <h3>{{a.name}}</h3>\n      <strong class=\"cp3-value\" :style=\"{color:a.current && a.value ? '#2e7d32':'#6b7280',fontSize:'26px'}\">{{!a.current ? 'sem estado atual' : a.value ? 'LIGADO' : 'desligado'}}</strong>\n      <p v-if=\"a.since\">{{a.observed ? 'Observado desde' : 'Desde'}} {{new Date(a.since).toLocaleTimeString('pt-BR')}}<span v-if=\"!a.current\"> · último conhecido: {{a.value ? 'ligado' : 'desligado'}}</span></p>\n      <p v-else class=\"cp3-muted\">Aguardando estado</p>\n      <p class=\"cp3-rule\">Regra: {{a.rule}}</p>\n      <p :style=\"{color:a.coherent === false ? '#ef6c00' : '#6b7280'}\">Coerência: {{a.coherent === null ? 'aguardando dados atuais' : a.coherent ? 'OK' : 'divergente'}}</p>\n    </article>\n  </div>\n</template>\n","storeOutMessages":true,"passthru":false,"resendOnRefresh":true,"templateScope":"local","className":"","x":850,"y":450,"wires":[[]]},{"id":"group-aroeira-history","type":"ui-group","name":"Histórico","page":"page-aroeira","width":"12","height":"1","order":4,"showTitle":true,"visible":"true","disabled":"false","groupType":"default"},{"id":"aroeira-history","type":"ui-template","z":"cp3-flow","group":"group-aroeira-history","page":"","ui":"","name":"Aroeira-vermelha · Histórico","order":1,"width":"12","height":"0","format":"<template>\n  <section class=\"cp3-charts\" v-if=\"msg?.payload\">\n    <article v-for=\"s in msg.payload.sensors\" :key=\"s.sensor\" class=\"cp3-card\">\n      <h3>{{s.sensor}} · {{s.unit}}</h3>\n      <svg viewBox=\"0 0 700 240\" class=\"cp3-chart\" role=\"img\" :aria-label=\"`Histórico de ${s.sensor} dos últimos 30 minutos; limiar ${s.limit} ${s.unit}`\">\n        <line v-for=\"v in [0,0.5,1]\" :key=\"v\" x1=\"50\" x2=\"680\" :y1=\"190-v*160\" :y2=\"190-v*160\" stroke=\"#e0e5ea\"/>\n        <text x=\"8\" y=\"194\">0</text><text x=\"8\" y=\"114\">{{s.max/2}}</text><text x=\"8\" y=\"34\">{{s.max}}</text>\n        <line x1=\"50\" x2=\"680\" :y1=\"y(s.limit,s.max)\" :y2=\"y(s.limit,s.max)\" stroke=\"#ef6c00\" stroke-width=\"2\" stroke-dasharray=\"7 5\"/>\n        <path :d=\"line(s,msg.payload)\" fill=\"none\" stroke=\"#1976d2\" stroke-width=\"2.5\"/>\n        <circle v-for=\"(p,i) in s.history\" :key=\"i\" :cx=\"x(p.x,msg.payload)\" :cy=\"y(p.y,s.max)\" r=\"2\" fill=\"#1976d2\"/>\n        <text v-if=\"!s.history.length\" x=\"365\" y=\"110\" text-anchor=\"middle\">sem leitura</text>\n        <text x=\"50\" y=\"216\">−30 min</text><text x=\"365\" y=\"216\" text-anchor=\"middle\">−15 min</text><text x=\"680\" y=\"216\" text-anchor=\"end\">agora</text>\n      </svg>\n      <p class=\"cp3-history-note\">Azul: leituras · tracejado: limiar {{s.limit}} {{s.unit}} · {{s.history.length}} amostra(s). Intervalos sem dados aparecem como lacunas.</p>\n    </article>\n  </section>\n</template>\n<script>\nexport default { methods: {\n  x(t,p){return 50+Math.max(0,Math.min(1,(t-(p.now-p.window))/p.window))*630},\n  y(v,max){return 190-Math.max(0,Math.min(max,v))/max*160},\n  line(s,p){return s.history.map((v,i)=>`${i===0 || v.x-s.history[i-1].x>24000?'M':'L'}${this.x(v.x,p)},${this.y(v.y,s.max)}`).join(' ')}\n} }\n</script>\n","storeOutMessages":true,"passthru":false,"resendOnRefresh":true,"templateScope":"local","className":"","x":850,"y":510,"wires":[[]]},{"id":"page-inga","type":"ui-page","name":"Ingá","ui":"base","path":"/inga","icon":"leaf","layout":"grid","theme":"theme","breakpoints":[{"name":"Default","px":"0","cols":"3"},{"name":"Tablet","px":"576","cols":"6"},{"name":"Desktop","px":"1024","cols":"12"}],"order":2,"visible":"true","disabled":"false"},{"id":"group-inga-general","type":"ui-group","name":"Estado geral","page":"page-inga","width":"12","height":"1","order":1,"showTitle":true,"visible":"true","disabled":"false","groupType":"default"},{"id":"inga-general","type":"ui-template","z":"cp3-flow","group":"group-inga-general","page":"","ui":"","name":"Ingá · Estado geral","order":1,"width":"12","height":"0","format":"<template>\n  <section v-if=\"msg?.payload\" class=\"cp3-general\" aria-live=\"polite\">\n    <nav class=\"cp3-tabs\" aria-label=\"Espécies\">\n      <a href=\"/dashboard/aroeira-vermelha\" :aria-current=\"msg.payload.slug==='aroeira-vermelha'?'page':undefined\">Aroeira-vermelha</a>\n      <a href=\"/dashboard/inga\" :aria-current=\"msg.payload.slug==='inga'?'page':undefined\">Ingá</a>\n    </nav>\n    <div class=\"cp3-status\" :style=\"{borderColor:msg.payload.color}\">\n      <strong :style=\"{color:msg.payload.color}\">{{msg.payload.general?.value || 'SEM DADOS'}}</strong>\n      <p>{{msg.payload.general?.reason}}</p>\n    </div>\n    <h2>{{msg.payload.name}}</h2><p><em>{{msg.payload.scientific}}</em> · {{msg.payload.family}}</p>\n    <p>Equipe {{msg.payload.team}} · Atualização: {{lastUpdate(msg.payload)}}</p>\n    <div class=\"cp3-connections\">\n      <span :class=\"msg.payload.broker ? 'cp3-good' : 'cp3-bad'\">HiveMQ: {{msg.payload.broker ? 'conectado' : 'desconectado'}}</span>\n      <span :class=\"msg.payload.bridge === 'online' ? 'cp3-good' : 'cp3-bad'\">Ponte local: {{msg.payload.bridge}}</span>\n      <span>Placa: {{msg.payload.board || 'sem status'}}</span>\n    </div>\n    <p class=\"cp3-small\">Banco: {{msg.payload.persistence.status}} · {{msg.payload.persistence.pending}} registro(s) na fila<span v-if=\"msg.payload.persistence.dropped\"> · {{msg.payload.persistence.dropped}} não armazenado(s)</span></p>\n  </section>\n  <p v-else>Sem leitura. Aguardando conexão.</p>\n</template>\n<script>\nexport default { methods: { lastUpdate(p) { const t = Math.max(...p.sensors.map(s => s.at || 0)); return t ? new Date(t).toLocaleTimeString('pt-BR') : 'sem leitura'; } } }\n</script>\n<style>\n.cp3-general h2{font-size:24px;margin:14px 0 4px}.cp3-general p{margin:6px 0;line-height:1.5}\n.cp3-status{border-left:6px solid;padding:12px 16px;background:#f7f8fa;border-radius:5px}\n.cp3-status strong{font-size:28px}.cp3-connections{display:flex;gap:12px;flex-wrap:wrap;margin:14px 0}\n.cp3-connections span{padding:6px 10px;border:1px solid #d8dee5;border-radius:6px}\n.cp3-good{color:#2e7d32}.cp3-bad{color:#c62828}.cp3-small{font-size:14px;color:#59616f}\n.cp3-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(260px,100%),1fr));gap:20px;padding:4px}\n.cp3-card{border:1px solid #d8dee5;border-radius:8px;padding:18px;min-width:0}.cp3-card h3{font-size:20px;margin:0 0 12px}\n.cp3-muted{color:#6b7280}.cp3-value{font-size:34px;font-weight:650;line-height:1.3}.cp3-unit{font-size:20px}\n.cp3-gauge{height:18px;position:relative;border-radius:3px;margin:22px 0 8px;border:1px solid #98a1ab}\n.cp3-needle{position:absolute;top:-6px;bottom:-6px;width:3px;background:#172330;transform:translateX(-50%)}\n.cp3-scale{display:flex;justify-content:space-between;font-size:13px}.cp3-card p{line-height:1.5;margin:8px 0}\n.cp3-chart{width:100%;height:auto;display:block}.cp3-chart text{font:13px sans-serif;fill:#505b68}\n.cp3-charts{display:grid;gap:20px}.cp3-rule{font-size:16px}.cp3-history-note{font-size:14px;color:#59616f}\n.cp3-tabs{display:flex;gap:8px;margin:0 0 16px;flex-wrap:wrap}.cp3-tabs a{padding:8px 14px;color:#374151;text-decoration:none;border-bottom:3px solid transparent}\n.cp3-tabs a[aria-current=page]{border-color:#2e7d32;color:#2e7d32;font-weight:700;background:#f0f7f0}\n@media(max-width:600px){.cp3-chart text{font-size:28px}}\n</style>\n","storeOutMessages":true,"passthru":false,"resendOnRefresh":true,"templateScope":"local","className":"","x":1150,"y":330,"wires":[[]]},{"id":"group-inga-sensors","type":"ui-group","name":"Sensores","page":"page-inga","width":"12","height":"1","order":2,"showTitle":true,"visible":"true","disabled":"false","groupType":"default"},{"id":"inga-sensors","type":"ui-template","z":"cp3-flow","group":"group-inga-sensors","page":"","ui":"","name":"Ingá · Sensores","order":1,"width":"12","height":"0","format":"<template>\n  <div class=\"cp3-grid\" v-if=\"msg?.payload\">\n    <article v-for=\"s in msg.payload.sensors\" :key=\"s.sensor\" class=\"cp3-card\" :class=\"{'cp3-muted': !s.current}\">\n      <h3>{{s.sensor}}</h3>\n      <div class=\"cp3-value\">{{s.value === null ? 'sem leitura' : s.value.toFixed(1)}} <span class=\"cp3-unit\" v-if=\"s.value !== null\">{{s.unit}}</span></div>\n      <p>{{s.age === null ? 'Aguardando primeira amostra' : `há ${s.age} s`}}<span v-if=\"s.value !== null && !s.current\"> · leitura não atual</span></p>\n      <div class=\"cp3-gauge\" role=\"meter\" :aria-label=\"s.sensor\" aria-valuemin=\"0\" :aria-valuemax=\"s.max\" :aria-valuenow=\"s.value === null ? undefined : Math.max(0,Math.min(s.max,s.value))\" :style=\"{background:bands(s),opacity:s.current?1:0.4}\">\n        <span v-if=\"s.value !== null\" class=\"cp3-needle\" :style=\"{left:Math.max(0,Math.min(100,s.value/s.max*100))+'%'}\"></span>\n      </div>\n      <div class=\"cp3-scale\"><span>0 {{s.unit}}</span><span>Limiar: {{s.limit}} {{s.unit}}</span><span>{{s.max}} {{s.unit}}</span></div>\n      <p class=\"cp3-small\">Amarelo: {{s.sensor}} {{s.op}} {{s.limit}} {{s.unit}}. Verde: sem atuação desta regra.</p>\n    </article>\n  </div>\n</template>\n<script>\nexport default { methods: { bands(s) { const a=s.limit/s.max*100,b=(a+100)/2; const c=s.op==='<'?['#fbc02d','#2e7d32','#2e7d32']:['#2e7d32','#fbc02d','#fbc02d']; return `linear-gradient(to right,${c[0]} 0%,${c[0]} ${a}%,${c[1]} ${a}%,${c[1]} ${b}%,${c[2]} ${b}%,${c[2]} 100%)`; } } }\n</script>\n","storeOutMessages":true,"passthru":false,"resendOnRefresh":true,"templateScope":"local","className":"","x":1150,"y":390,"wires":[[]]},{"id":"group-inga-actuators","type":"ui-group","name":"Atuadores","page":"page-inga","width":"12","height":"1","order":3,"showTitle":true,"visible":"true","disabled":"false","groupType":"default"},{"id":"inga-actuators","type":"ui-template","z":"cp3-flow","group":"group-inga-actuators","page":"","ui":"","name":"Ingá · Atuadores","order":1,"width":"12","height":"0","format":"<template>\n  <div class=\"cp3-grid\" v-if=\"msg?.payload\">\n    <article v-for=\"a in msg.payload.actuators\" :key=\"a.name\" class=\"cp3-card\">\n      <h3>{{a.name}}</h3>\n      <strong class=\"cp3-value\" :style=\"{color:a.current && a.value ? '#2e7d32':'#6b7280',fontSize:'26px'}\">{{!a.current ? 'sem estado atual' : a.value ? 'LIGADO' : 'desligado'}}</strong>\n      <p v-if=\"a.since\">{{a.observed ? 'Observado desde' : 'Desde'}} {{new Date(a.since).toLocaleTimeString('pt-BR')}}<span v-if=\"!a.current\"> · último conhecido: {{a.value ? 'ligado' : 'desligado'}}</span></p>\n      <p v-else class=\"cp3-muted\">Aguardando estado</p>\n      <p class=\"cp3-rule\">Regra: {{a.rule}}</p>\n      <p :style=\"{color:a.coherent === false ? '#ef6c00' : '#6b7280'}\">Coerência: {{a.coherent === null ? 'aguardando dados atuais' : a.coherent ? 'OK' : 'divergente'}}</p>\n    </article>\n  </div>\n</template>\n","storeOutMessages":true,"passthru":false,"resendOnRefresh":true,"templateScope":"local","className":"","x":1150,"y":450,"wires":[[]]},{"id":"group-inga-history","type":"ui-group","name":"Histórico","page":"page-inga","width":"12","height":"1","order":4,"showTitle":true,"visible":"true","disabled":"false","groupType":"default"},{"id":"inga-history","type":"ui-template","z":"cp3-flow","group":"group-inga-history","page":"","ui":"","name":"Ingá · Histórico","order":1,"width":"12","height":"0","format":"<template>\n  <section class=\"cp3-charts\" v-if=\"msg?.payload\">\n    <article v-for=\"s in msg.payload.sensors\" :key=\"s.sensor\" class=\"cp3-card\">\n      <h3>{{s.sensor}} · {{s.unit}}</h3>\n      <svg viewBox=\"0 0 700 240\" class=\"cp3-chart\" role=\"img\" :aria-label=\"`Histórico de ${s.sensor} dos últimos 30 minutos; limiar ${s.limit} ${s.unit}`\">\n        <line v-for=\"v in [0,0.5,1]\" :key=\"v\" x1=\"50\" x2=\"680\" :y1=\"190-v*160\" :y2=\"190-v*160\" stroke=\"#e0e5ea\"/>\n        <text x=\"8\" y=\"194\">0</text><text x=\"8\" y=\"114\">{{s.max/2}}</text><text x=\"8\" y=\"34\">{{s.max}}</text>\n        <line x1=\"50\" x2=\"680\" :y1=\"y(s.limit,s.max)\" :y2=\"y(s.limit,s.max)\" stroke=\"#ef6c00\" stroke-width=\"2\" stroke-dasharray=\"7 5\"/>\n        <path :d=\"line(s,msg.payload)\" fill=\"none\" stroke=\"#1976d2\" stroke-width=\"2.5\"/>\n        <circle v-for=\"(p,i) in s.history\" :key=\"i\" :cx=\"x(p.x,msg.payload)\" :cy=\"y(p.y,s.max)\" r=\"2\" fill=\"#1976d2\"/>\n        <text v-if=\"!s.history.length\" x=\"365\" y=\"110\" text-anchor=\"middle\">sem leitura</text>\n        <text x=\"50\" y=\"216\">−30 min</text><text x=\"365\" y=\"216\" text-anchor=\"middle\">−15 min</text><text x=\"680\" y=\"216\" text-anchor=\"end\">agora</text>\n      </svg>\n      <p class=\"cp3-history-note\">Azul: leituras · tracejado: limiar {{s.limit}} {{s.unit}} · {{s.history.length}} amostra(s). Intervalos sem dados aparecem como lacunas.</p>\n    </article>\n  </section>\n</template>\n<script>\nexport default { methods: {\n  x(t,p){return 50+Math.max(0,Math.min(1,(t-(p.now-p.window))/p.window))*630},\n  y(v,max){return 190-Math.max(0,Math.min(max,v))/max*160},\n  line(s,p){return s.history.map((v,i)=>`${i===0 || v.x-s.history[i-1].x>24000?'M':'L'}${this.x(v.x,p)},${this.y(v.y,s.max)}`).join(' ')}\n} }\n</script>\n","storeOutMessages":true,"passthru":false,"resendOnRefresh":true,"templateScope":"local","className":"","x":1150,"y":510,"wires":[[]]},{"id":"test-normal","type":"inject","z":"cp3-flow","name":"TESTE SINTÉTICO normal","props":[{"p":"payload"}],"payload":"normal","payloadType":"str","once":false,"repeat":"","wires":[["test-fixture"]]},{"id":"test-acting","type":"inject","z":"cp3-flow","name":"TESTE SINTÉTICO acting","props":[{"p":"payload"}],"payload":"acting","payloadType":"str","once":false,"repeat":"","wires":[["test-fixture"]]},{"id":"test-offline","type":"inject","z":"cp3-flow","name":"TESTE SINTÉTICO offline","props":[{"p":"payload"}],"payload":"offline","payloadType":"str","once":false,"repeat":"","wires":[["test-fixture"]]},{"id":"test-fixture","type":"function","z":"cp3-flow","name":"SOMENTE TESTES AUTOMATIZADOS","func":"const p='unidavi/iot/t28/1038854_1028775/';\nconst mode=msg.payload;const rows=[{kind:'broker',connected:true},{topic:p+'ponte/status',payload:'online'}];\nfor(const slug of ['aroeira-vermelha','inga']){\nrows.push({topic:p+slug+'/status',payload:mode==='offline'?'offline':'online'});\nfor(const [name,val] of Object.entries({'umidade-solo':mode==='acting'?20:80,luminosidade:mode==='acting'?95:41,temperatura:mode==='acting'?31:24.7})) rows.push({topic:p+slug+'/sensor/'+name,payload:JSON.stringify({valor:val,unidade:name==='temperatura'?'°C':'%'})});\nfor(const name of ['irrigacao',slug==='inga'?'ventilacao':'sombreamento'])rows.push({topic:p+slug+'/atuador/'+name,payload:JSON.stringify({estado:mode==='acting'?'ligado':'desligado'})});\n}\nreturn [rows];","outputs":1,"wires":[["monitor"]]},{"id":"test-reset","type":"inject","z":"cp3-flow","name":"Limpar dados sintéticos","props":[{"p":"payload"}],"payload":"","payloadType":"str","once":false,"repeat":"","wires":[["test-clear"]]},{"id":"test-clear","type":"function","z":"cp3-flow","name":"Restaurar preview vazio","func":"flow.set('monitor',global.get('cp3').create('1038854_1028775'));return {kind:'tick'};","outputs":1,"wires":[["monitor"]]}]